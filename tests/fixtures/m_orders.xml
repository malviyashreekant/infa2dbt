<?xml version="1.0" encoding="UTF-8"?>
<POWERMART>
<REPOSITORY NAME="REPO">
<FOLDER NAME="DEMO">
<SOURCE NAME="ORDERS" DBDNAME="ORCL" OWNERNAME="SALES" DATABASETYPE="Oracle">
  <SOURCEFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="CUST_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="STATUS" DATATYPE="string" PRECISION="1" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="ORDER_DT" DATATYPE="date/time" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>
<SOURCE NAME="CUSTOMERS" DBDNAME="ORCL" OWNERNAME="SALES" DATABASETYPE="Oracle">
  <SOURCEFIELD NAME="CUST_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="CUST_NAME" DATATYPE="string" PRECISION="50" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="SEGMENT" DATATYPE="string" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>
<TARGET NAME="FCT_ORDERS_HIGH" DATABASETYPE="Oracle">
  <TARGETFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="BAND" DATATYPE="string" PRECISION="4" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="STATUS_DESC" DATATYPE="string" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="REGION" DATATYPE="string" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="SK" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>
<TARGET NAME="FCT_ORDERS_LOW" DATABASETYPE="Oracle">
  <TARGETFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="BAND" DATATYPE="string" PRECISION="4" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="STATUS_DESC" DATATYPE="string" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>
<MAPPING NAME="m_orders">
<TRANSFORMATION NAME="SQ_ORDERS_CUSTOMERS" TYPE="Source Qualifier" REUSABLE="NO">
  <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="CUST_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="STATUS" DATATYPE="string" PRECISION="1" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="ORDER_DT" DATATYPE="date/time" PRECISION="19" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="CUST_NAME" DATATYPE="string" PRECISION="50" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TABLEATTRIBUTE NAME="User Defined Join" VALUE="ORDERS.CUST_ID = CUSTOMERS.CUST_ID"/>
  <TABLEATTRIBUTE NAME="Source Filter" VALUE="ORDERS.STATUS &lt;&gt; 'X'"/>
  <TABLEATTRIBUTE NAME="Sql Query" VALUE=""/>
  <TABLEATTRIBUTE NAME="Number Of Sorted Ports" VALUE="0"/>
</TRANSFORMATION>
<TRANSFORMATION NAME="SEQ_KEY" TYPE="Sequence" REUSABLE="NO">
  <TRANSFORMFIELD NAME="NEXTVAL" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
  <TRANSFORMFIELD NAME="CURRVAL" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
  <TABLEATTRIBUTE NAME="Start Value" VALUE="1000"/>
  <TABLEATTRIBUTE NAME="Increment By" VALUE="1"/>
  <TABLEATTRIBUTE NAME="Cycle" VALUE="NO"/>
</TRANSFORMATION>
<TRANSFORMATION NAME="EXP_CALC" TYPE="Expression" REUSABLE="NO">
  <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="CUST_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
  <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="STATUS" DATATYPE="string" PRECISION="1" SCALE="0" PORTTYPE="INPUT"/>
  <TRANSFORMFIELD NAME="ORDER_DT" DATATYPE="date/time" PRECISION="19" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="CUST_NAME" DATATYPE="string" PRECISION="50" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="SK" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
  <TRANSFORMFIELD NAME="v_AMT_ROUNDED" DATATYPE="number(p,s)" PRECISION="12" SCALE="0" PORTTYPE="LOCAL VARIABLE" EXPRESSION="ROUND(AMOUNT, 0)" EXPRESSIONTYPE="GENERAL"/>
  <TRANSFORMFIELD NAME="v_BAND" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="LOCAL VARIABLE" EXPRESSION="IIF(v_AMT_ROUNDED &gt; 1000, 'HIGH', 'LOW')" EXPRESSIONTYPE="GENERAL"/>
  <TRANSFORMFIELD NAME="o_BAND" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="OUTPUT" EXPRESSION="v_BAND" EXPRESSIONTYPE="GENERAL"/>
  <TRANSFORMFIELD NAME="o_STATUS_DESC" DATATYPE="string" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" EXPRESSION="DECODE(STATUS, 'O', 'Open', 'C', 'Closed', 'Other')" EXPRESSIONTYPE="GENERAL"/>
  <TRANSFORMFIELD NAME="o_REGION" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="OUTPUT" EXPRESSION=":LKP.LKP_REGION(CUST_ID)" EXPRESSIONTYPE="GENERAL"/>
  <TRANSFORMFIELD NAME="o_ORDER_YEAR" DATATYPE="number(p,s)" PRECISION="4" SCALE="0" PORTTYPE="OUTPUT" EXPRESSION="GET_DATE_PART(ORDER_DT, 'YYYY')" EXPRESSIONTYPE="GENERAL"/>
  <TRANSFORMFIELD NAME="o_ORDER_SK" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" EXPRESSION="SK" EXPRESSIONTYPE="GENERAL"/>
</TRANSFORMATION>
<TRANSFORMATION NAME="LKP_REGION" TYPE="Lookup Procedure" REUSABLE="NO">
  <TRANSFORMFIELD NAME="in_CUST_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
  <TRANSFORMFIELD NAME="CUST_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="LOOKUP/OUTPUT"/>
  <TRANSFORMFIELD NAME="REGION_NAME" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="LOOKUP/OUTPUT/RETURN"/>
  <TABLEATTRIBUTE NAME="Lookup table name" VALUE="SALES.CUST_REGION"/>
  <TABLEATTRIBUTE NAME="Lookup condition" VALUE="CUST_ID = in_CUST_ID"/>
  <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use First Value"/>
</TRANSFORMATION>
<TRANSFORMATION NAME="FIL_VALID" TYPE="Filter" REUSABLE="NO">
  <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_BAND" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_STATUS_DESC" DATATYPE="string" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_REGION" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_ORDER_SK" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TABLEATTRIBUTE NAME="Filter Condition" VALUE="AMOUNT &gt; 0 AND NOT ISNULL(ORDER_ID)"/>
</TRANSFORMATION>
<TRANSFORMATION NAME="RTR_SPLIT" TYPE="Router" REUSABLE="NO">
  <GROUP NAME="INPUT" TYPE="INPUT"/>
  <GROUP NAME="HIGH" TYPE="OUTPUT" EXPRESSION="o_BAND = 'HIGH'"/>
  <GROUP NAME="LOW" TYPE="OUTPUT" EXPRESSION="o_BAND = 'LOW'"/>
  <GROUP NAME="DEFAULT1" TYPE="OUTPUT/DEFAULT" EXPRESSION=""/>
  <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT" GROUP="INPUT"/>
  <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="INPUT" GROUP="INPUT"/>
  <TRANSFORMFIELD NAME="o_BAND" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="INPUT" GROUP="INPUT"/>
  <TRANSFORMFIELD NAME="o_STATUS_DESC" DATATYPE="string" PRECISION="10" SCALE="0" PORTTYPE="INPUT" GROUP="INPUT"/>
  <TRANSFORMFIELD NAME="o_REGION" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="INPUT" GROUP="INPUT"/>
  <TRANSFORMFIELD NAME="o_ORDER_SK" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT" GROUP="INPUT"/>
  <TRANSFORMFIELD NAME="ORDER_ID1" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" GROUP="HIGH" REF_FIELD="ORDER_ID"/>
  <TRANSFORMFIELD NAME="AMOUNT1" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="OUTPUT" GROUP="HIGH" REF_FIELD="AMOUNT"/>
  <TRANSFORMFIELD NAME="o_BAND1" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="OUTPUT" GROUP="HIGH" REF_FIELD="o_BAND"/>
  <TRANSFORMFIELD NAME="o_STATUS_DESC1" DATATYPE="string" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" GROUP="HIGH" REF_FIELD="o_STATUS_DESC"/>
  <TRANSFORMFIELD NAME="o_REGION1" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="OUTPUT" GROUP="HIGH" REF_FIELD="o_REGION"/>
  <TRANSFORMFIELD NAME="o_ORDER_SK1" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" GROUP="HIGH" REF_FIELD="o_ORDER_SK"/>
  <TRANSFORMFIELD NAME="ORDER_ID2" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" GROUP="LOW"/>
  <TRANSFORMFIELD NAME="AMOUNT2" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="OUTPUT" GROUP="LOW"/>
  <TRANSFORMFIELD NAME="o_BAND2" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="OUTPUT" GROUP="LOW"/>
  <TRANSFORMFIELD NAME="o_STATUS_DESC2" DATATYPE="string" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" GROUP="LOW"/>
  <TRANSFORMFIELD NAME="o_REGION2" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="OUTPUT" GROUP="LOW"/>
  <TRANSFORMFIELD NAME="o_ORDER_SK2" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT" GROUP="LOW"/>
</TRANSFORMATION>
<TRANSFORMATION NAME="UPD_HIGH" TYPE="Update Strategy" REUSABLE="NO">
  <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="number(p,s)" PRECISION="12" SCALE="2" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_BAND" DATATYPE="string" PRECISION="4" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_STATUS_DESC" DATATYPE="string" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_REGION" DATATYPE="string" PRECISION="30" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TRANSFORMFIELD NAME="o_ORDER_SK" DATATYPE="number(p,s)" PRECISION="10" SCALE="0" PORTTYPE="INPUT/OUTPUT"/>
  <TABLEATTRIBUTE NAME="Update Strategy Expression" VALUE="IIF(ISNULL(o_REGION), DD_REJECT, IIF(o_STATUS_DESC = 'Closed', DD_DELETE, DD_UPDATE))"/>
</TRANSFORMATION>
